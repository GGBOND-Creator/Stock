{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stock_motion_daily_v1.schema.json",
  "title": "Stock Motion Daily Event",
  "description": "One long-form internal motion event. CSV rows use the same field contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "entity_id",
    "event_time",
    "available_time",
    "availability_policy",
    "channel",
    "value",
    "unit",
    "evidence_kind",
    "method",
    "source",
    "market",
    "adjustment",
    "volume_unit",
    "quality_status"
  ],
  "properties": {
    "schema_version": { "const": "stock_motion_daily_v1" },
    "event_id": { "type": "string", "minLength": 1 },
    "entity_id": { "type": "string", "minLength": 1 },
    "event_time": { "type": "string", "format": "date" },
    "available_time": { "type": "string", "format": "date" },
    "availability_policy": { "const": "available_after_session_close" },
    "channel": { "type": "string", "minLength": 1 },
    "value": { "type": "number" },
    "unit": { "type": "string", "minLength": 1 },
    "evidence_kind": { "enum": ["observation", "derived", "proxy"] },
    "method": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "market": { "type": "string", "minLength": 1 },
    "adjustment": { "type": "string", "minLength": 1 },
    "volume_unit": { "type": "string", "minLength": 1 },
    "quality_status": { "type": "string", "minLength": 1 }
  }
}
