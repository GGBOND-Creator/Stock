{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stock_motion_event_v2.schema.json",
  "title": "Unified Stock Motion Event v2",
  "description": "A source-aware internal event that can combine market observations, reviewed production evidence, and explicit proxies without erasing availability delays.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "entity_id",
    "source_schema",
    "source_record_id",
    "source_entity_id",
    "dimension_id",
    "dimension_name",
    "event_time",
    "available_time",
    "availability_policy",
    "channel",
    "value",
    "unit",
    "evidence_kind",
    "method",
    "source",
    "market",
    "adjustment",
    "volume_unit",
    "quality_status"
  ],
  "properties": {
    "schema_version": { "const": "stock_motion_event_v2" },
    "event_id": { "type": "string", "minLength": 1 },
    "entity_id": { "type": "string", "minLength": 1 },
    "source_schema": { "type": "string", "minLength": 1 },
    "source_record_id": { "type": "string", "minLength": 1 },
    "source_entity_id": { "type": "string", "minLength": 1 },
    "dimension_id": { "type": ["string", "null"] },
    "dimension_name": { "type": ["string", "null"] },
    "event_time": { "type": "string", "minLength": 1 },
    "available_time": { "type": "string", "minLength": 1 },
    "availability_policy": { "type": "string", "minLength": 1 },
    "channel": { "type": "string", "minLength": 1 },
    "value": { "type": "number" },
    "unit": { "type": "string", "minLength": 1 },
    "evidence_kind": { "enum": ["observation", "derived", "proxy"] },
    "method": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "market": { "type": "string", "minLength": 1 },
    "adjustment": { "type": "string", "minLength": 1 },
    "volume_unit": { "type": "string", "minLength": 1 },
    "quality_status": { "type": "string", "minLength": 1 }
  }
}
